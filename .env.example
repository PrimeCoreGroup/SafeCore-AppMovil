# Copia este archivo como .env y ejecuta:
#   flutter run --dart-define-from-file=.env
# No subas tu .env al repositorio y NUNCA pongas aquí credenciales de base de
# datos ni contraseñas: los valores de dart-define quedan dentro del binario.

APP_ENV=production

# Backend SafeCore (ASP.NET Core en Render). Es el valor por defecto aunque no
# uses este archivo.
API_BASE_URL=https://backend-safecore.onrender.com

# true = arranca en modo demostración (datos ficticios). También se puede
# activar desde el login con "Explorar en modo demostración".
DEMO_MODE=false

# true = inicializa Firebase Cloud Messaging (requiere configurar Firebase).
FIREBASE_ENABLED=false

CONNECT_TIMEOUT_MS=15000
RECEIVE_TIMEOUT_MS=20000

# Refresco automático mientras la app está abierta y antigüedad máxima de los
# datos antes de marcarlos como desactualizados (segundos).
POLL_INTERVAL_SECONDS=30
STALE_AFTER_SECONDS=300

EDGE_CONFIRMATION_TIMEOUT_SECONDS=60

# Solo desarrollo local con `dotnet run` (p. ej. http://10.0.2.2:5000).
ALLOW_INSECURE_HTTP=false
